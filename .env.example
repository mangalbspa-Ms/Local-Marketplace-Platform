# Required AI Assistant Secret (automatically populated by Google AI Studio)
GEMINI_API_KEY=

# ==============================================================================
# OPTIONAL PRODUCTION OVERRIDES (NOT REQUIRED FOR LOCAL DEVELOPMENT)
# The application automatically uses persistent JSON storage in /data, built-in
# payment sandbox simulation, and local disk media storage in development.
# ==============================================================================
#
# Production PostgreSQL Database:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/marketplace
#
# Production Authentication Secrets:
# JWT_SECRET=your-production-256-bit-secret-key-here
# SESSION_SECRET=your-production-session-secret-here
#
# Production Payment Gateway (Razorpay / Stripe):
# PAYMENT_GATEWAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# PAYMENT_GATEWAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
#
# Production Cloud Storage (s3 | gcs):
# IMAGE_STORAGE_PROVIDER=local
# IMAGE_STORAGE_BUCKET=your-production-media-bucket
#
# Application URLs:
# APP_URL=https://your-marketplace.com
# API_URL=https://your-marketplace.com/api

